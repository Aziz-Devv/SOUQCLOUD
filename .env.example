# SOUQCLOUD Environment Configuration Contract

# 1. Public Environment Variables (Browser & Edge Safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=souqcloud.com
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-publishable-key

# 2. Server-Only Secret Keys (STRICTLY SERVER-ONLY)
# Database direct connection URL (for migrations)
DATABASE_URL=postgresql://postgres:placeholder-password@db.placeholder-project.supabase.co:5432/postgres

# Supabase Server Secret Key (Restricted to Paddle Webhooks & System Workers)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-secret-key

# Paddle Platform SaaS Subscription Billing (Phase 1)
PADDLE_API_KEY=placeholder_paddle_api_key
PADDLE_WEBHOOK_SECRET=placeholder_paddle_webhook_secret
PADDLE_ENVIRONMENT=sandbox

# Cloudflare R2 Media Storage
CLOUDFLARE_R2_ACCOUNT_ID=placeholder_r2_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=souqcloud-media-dev
CLOUDFLARE_R2_PUBLIC_DOMAIN=media.souqcloud.com

# Cloudflare Edge Purge API (Publishing Cache Invalidation)
CLOUDFLARE_ZONE_ID=placeholder_zone_id
CLOUDFLARE_PURGE_API_TOKEN=placeholder_purge_api_token

# Cloudflare for SaaS (Custom Domains)
CLOUDFLARE_API_TOKEN=placeholder_custom_domains_api_token
CLOUDFLARE_FALLBACK_ORIGIN=cname.souqcloud.com
